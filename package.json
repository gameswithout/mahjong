{
  "name": "mahjong-online",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:practice": "vitest run client/App.practice.test.tsx client/practice-flow.test.ts client/PracticeLaunchCard.test.tsx client/HandResultScreen.test.tsx client/match-runtime.test.ts client/session.test.ts",
    "test:table-ux": "vitest run client/MatchTable.ux.test.tsx client/App.test.ts client/App.practice.test.tsx client/matchTableAdapter.test.ts",
    "test:four-human": "npm run build && node --env-file=.env scripts/test-four-human.mjs",
    "test:watch": "vitest",
    "evidence:ui": "node scripts/run-ui-evidence.mjs",
    "evidence:bundle": "node scripts/check-bundle-budget.mjs",
    "i18n:export": "node scripts/export-translations.mjs",
    "capture:table": "node scripts/validate-match-table-wireframe.mjs",
    "test:essential-layout": "node scripts/validate-essential-layout.mjs",
    "capture:results": "node scripts/capture-result-evidence.mjs",
    "capture:onboarding": "node scripts/capture-onboarding-evidence.mjs",
    "smoke:matchmaking": "node --env-file=.env scripts/smoke-matchmaking.mjs",
    "smoke:telemetry": "node --env-file=.env scripts/smoke-game-telemetry.mjs"
  },
  "dependencies": {
    "@accelbyte/sdk": "4.3.2",
    "@accelbyte/sdk-iam": "6.3.5",
    "@accelbyte/sdk-lobby": "^5.2.7",
    "peerjs": "^1.5.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.4.1",
    "jsdom": "^25.0.0",
    "playwright": "^1.55.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.1"
  }
}
