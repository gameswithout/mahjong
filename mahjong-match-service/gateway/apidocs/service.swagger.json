{
  "swagger": "2.0",
  "info": {
    "title": "Mahjong Match Service API",
    "version": "v1"
  },
  "tags": [
    {
      "name": "Service"
    }
  ],
  "basePath": "/mahjong",
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/namespaces/{namespace}/achievements": {
      "get": {
        "summary": "Get the caller's achievement catalog and exact progress",
        "description": "Merges the caller's AGS Achievement progress with the complete visible Alpha achievement catalog. Entries whose tracking or game mode is unavailable remain visible with an eligibility reason.",
        "operationId": "Service_GetPlayerAchievements",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/serviceGetPlayerAchievementsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "Service"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/namespaces/{namespace}/jade": {
      "get": {
        "summary": "Get the authenticated player's Jade account",
        "description": "Creates the two idempotent new-player grants when needed and returns authoritative Bamboo eligibility and available balance.",
        "operationId": "Service_GetJadeAccount",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/serviceGetJadeAccountResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "Service"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/namespaces/{namespace}/jade/reservation": {
      "delete": {
        "summary": "Release an unbound Bamboo Courtyard reservation",
        "description": "Releases the caller's queue reservation. A reservation already bound to a match remains locked until settlement.",
        "operationId": "Service_ReleaseJade",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/serviceReleaseJadeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "Service"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "post": {
        "summary": "Reserve the Bamboo Courtyard debit cap",
        "description": "Atomically checks eligibility and locks 300 Jade before the player creates a public matchmaking ticket.",
        "operationId": "Service_ReserveJade",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/serviceReserveJadeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ServiceReserveJadeBody"
            }
          }
        ],
        "tags": [
          "Service"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/namespaces/{namespace}/jade/welfare": {
      "post": {
        "summary": "Claim the daily Jade welfare top-up",
        "description": "Sets a locked-out balance to the 1,000-Jade Bamboo minimum, once per UTC day, for a player who has completed an AI Practice hand that day. A refused claim returns a reason code rather than an error.",
        "operationId": "Service_ClaimJadeWelfare",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/serviceClaimJadeWelfareResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ServiceClaimJadeWelfareBody"
            }
          }
        ],
        "tags": [
          "Service"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/namespaces/{namespace}/match-history": {
      "get": {
        "summary": "Get the caller's completed Mahjong sessions",
        "description": "Returns newest-first completed session summaries derived from the authoritative match event and XP ledgers.",
        "operationId": "Service_GetMatchHistory",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/serviceGetMatchHistoryResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "Service"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/namespaces/{namespace}/progression": {
      "get": {
        "summary": "Get the caller's XP, level, and earned rewards",
        "description": "Returns the §12.2 standing derived from lifetime XP plus the full level curve. Level never gates a lobby.",
        "operationId": "Service_GetProgression",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/serviceGetProgressionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "Service"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/namespaces/{namespace}/progression/onboarding": {
      "post": {
        "summary": "Grant the one-time onboarding XP",
        "description": "Awarded whether the player completed or intentionally skipped the tutorial (§10.4). Idempotent: replays grant nothing further.",
        "operationId": "Service_AwardOnboardingXP",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/serviceAwardOnboardingXPResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ServiceAwardOnboardingXPBody"
            }
          }
        ],
        "tags": [
          "Service"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/namespaces/{namespace}/sessions/{sessionId}/matches/{matchId}": {
      "get": {
        "summary": "Get the authenticated player's match state",
        "description": "Returns the latest authoritative match projection visible to the authenticated Session member.",
        "operationId": "Service_GetMatchState",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/serviceGetMatchStateResponse"
