        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/namespaces/{namespace}/statistics": {
      "get": {
        "summary": "Get the caller's own Quick Play statistics",
        "description": "Reads the caller's AGS Statistics counters (§P2.3 dashboard). Served here rather than read from AGS by the browser because the AGS Social API sends no CORS headers, so a browser cannot call it directly.",
        "operationId": "Service_GetPlayerStatistics",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/serviceGetPlayerStatisticsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
