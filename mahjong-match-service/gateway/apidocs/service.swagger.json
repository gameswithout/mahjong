          "type": "string",
          "description": "RFC 3339 instant at which §8.4's 60-minute limit expires. The hand in\nprogress then is finished before the match ends."
        },
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "description": "\"rotation_complete\" or \"time_limit\". §8.4 makes the share of matches\nending on the limit a required telemetry metric, so the two endings are\nnever merged."
        },
        "nextHandOpensAt": {
          "type": "string",
          "description": "RFC 3339 instant at which the next hand opens, set while a completed\nhand's result is on screen and the rotation continues."
        },
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/serviceRotationPlacement"
          },
          "description": "Final standings, present once the match is complete."
        },
        "placementXpAward": {
          "$ref": "#/definitions/serviceHandXPAward",
          "description": "§12.1 XP for the completed rotation, paid once at the end."
        }
      },
      "description": "RotationState is the §8.4 Full Rotation around the current hand.\n\nStandings are keyed by player rather than by seat because a player's seat\nwind changes every time the dealership moves, so a seat does not identify\nanyone across a rotation."
    },
